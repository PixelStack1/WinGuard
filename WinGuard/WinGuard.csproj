<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinGuard</AssemblyName>
    <RootNamespace>WinGuard</RootNamespace>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <InformationalVersion>1.0.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>WinGuard</Product>
    <Authors>Corpse</Authors>
    <Company>Corpse</Company>
    <Copyright>© Corpse</Copyright>
    <ApplicationIcon>winguard.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\settings.json" LogicalName="WinGuard.Data.settings.json" />
    <Resource Include="Assets\winguard-logo.png" />
    <Resource Include="winguard.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinGuard.Core\WinGuard.Core.csproj" />
  </ItemGroup>
</Project>
