<Window x:Class="WinGuard.Views.MainWindow"
        Icon="pack://application:,,,/winguard.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinGuard.ViewModels"
        xmlns:loc="clr-namespace:WinGuard.Localization"
        Title="WinGuard" Width="1320" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="18" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource WindowBorder}" BorderThickness="1"
            SizeChanged="RootBorder_SizeChanged">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" CornerRadius="18" Background="{StaticResource WindowGlow}" IsHitTestVisible="False"/>

        <!-- ================= SIDEBAR ================= -->
        <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="20" Margin="10,10,0,10">
            <DockPanel Margin="14,18,14,14">
                <!-- Logo -->
                <Grid DockPanel.Dock="Top" Margin="4,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/winguard-logo.png" Height="44" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                        </Image.Effect>
                    </Image>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinGuard" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{loc:Tr AppTagline}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                        <TextBlock Text="by Corpse" FontSize="9.5" FontStyle="Italic" Opacity="0.6" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>

                <!-- Protection gauge -->
                <Border DockPanel.Dock="Bottom" CornerRadius="18" Background="{StaticResource CardBg}" Padding="16" Margin="0,12,0,0"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Effect="{StaticResource CardGlow}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr PrivacyScore}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <Grid Width="120" Height="120" Margin="0,10,0,8">
                            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10" Margin="5"/>
                            <Path Stroke="{StaticResource AccentGradient}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding ProtectionPercent, Converter={StaticResource PctArc}, ConverterParameter=120}" Effect="{StaticResource Glow}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PrivacyScore}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="/ 100" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SummaryText}" FontSize="12.5" Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Border CornerRadius="14" Background="#10FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="10,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#34D399" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                                    <Ellipse Width="7" Height="7" Fill="#FB7185" Visibility="{Binding IsAdmin, Converter={StaticResource InvBoolToVis}}"/>
                                    <TextBlock Text="{Binding AdminText}" FontSize="11" Margin="7,0,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Edition}" FontSize="10.5" Margin="14,2,0,0" Foreground="#6B6688" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Categories}" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,8" Foreground="{StaticResource TextSecondary}"/>
                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" CornerRadius="9" Background="#1AFFFFFF" Padding="8,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>   <!-- title bar -->
                <RowDefinition Height="Auto"/> <!-- header -->
                <RowDefinition Height="Auto"/> <!-- toolbar -->
                <RowDefinition Height="*"/>    <!-- content -->
                <RowDefinition Height="Auto"/> <!-- activity drawer -->
            </Grid.RowDefinitions>

            <!-- Title bar (drag handled by WindowChrome caption + DragMove fallback) -->
            <DockPanel Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0">
                    <Button Style="{StaticResource BaseButton}" Command="{Binding ToggleLanguageCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{loc:Tr LanguageTip}" Margin="0,0,12,0" Padding="12,5" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF2B7;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FR" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding L.IsFrench}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text=" / " Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="EN" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding L.IsFrench}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource WindowButton}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Margin="0,0,6,0" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <TextBox Style="{StaticResource SearchBox}" Width="360" Height="34" HorizontalAlignment="Left" Margin="28,12,0,0"
                         WindowChrome.IsHitTestVisibleInChrome="True"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <!-- Header -->
            <Grid Grid.Row="1" Margin="28,18,28,6">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Tr HeaderSubtitle}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr ScopeAll}" GroupName="Scope"
                                 IsChecked="{Binding ScopeFilter, Converter={StaticResource EqualsConv}, ConverterParameter=All}"/>
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr ScopeCU}" GroupName="Scope"
                                 IsChecked="{Binding ScopeFilter, Converter={StaticResource EqualsConv}, ConverterParameter='Current User'}"/>
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Tr ScopeLM}" GroupName="Scope"
                                 IsChecked="{Binding ScopeFilter, Converter={StaticResource EqualsConv}, ConverterParameter='Local Machine'}"/>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <StackPanel Grid.Row="2" Margin="28,12,28,8">
            <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding MaximumPrivacyCommand}" Margin="0,0,8,8" ToolTip="{loc:Tr MaxPrivacyTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr MaxPrivacy}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyRecommendedCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr ApplyRecommended}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BaseButton}" Command="{Binding ApplyLimitedCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Foreground="#F5B041" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr ApplyLimited}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BaseButton}" Command="{Binding ApplyAllCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE814;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" Foreground="#FF5C6C" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr ApplyAll}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Command="{Binding UndoAllCommand}" Margin="0,0,16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr UndoAll}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BaseButton}" Command="{Binding RestorePointCommand}" Margin="0,0,8,8" ToolTip="{loc:Tr RestorePointTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr RestorePoint}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BaseButton}" Command="{Binding RestoreBackupCommand}" Margin="0,0,8,8" ToolTip="{loc:Tr RestoreBackupTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr RestoreBackup}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BaseButton}" Command="{Binding ExportCommand}" Margin="0,0,8,8" ToolTip="{loc:Tr ExportTip}">
                    <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}"/>
                </Button>
                <Button Style="{StaticResource BaseButton}" Command="{Binding ImportCommand}" Margin="0,0,8,8" ToolTip="{loc:Tr ImportTip}">
                    <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}"/>
                </Button>
                <Button Style="{StaticResource BaseButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" ToolTip="{loc:Tr RefreshTip}">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}"/>
                </Button>
            </WrapPanel>
            <WrapPanel Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,8">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RestorePointBeforeApply}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Tr RpBeforeApply}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8" ToolTip="{loc:Tr AutoReapplyTip}">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoReapply}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Tr AutoReapply}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>
            </StackPanel>

            <!-- Settings (grouped cards) -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="28,4,22,16">
                <ItemsControl ItemsSource="{Binding SettingsView}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Border CornerRadius="22" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                                        BorderThickness="1" Margin="0,0,0,20" Padding="12" Effect="{StaticResource CardGlow}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="14,10,14,8">
                                                            <Border Width="5" Height="20" CornerRadius="3" Background="{StaticResource AccentGradient}" Margin="0,0,10,0" Effect="{StaticResource PinkGlow}"/>
                                                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource CatName}">
                                                                        <Binding Path="Name"/>
                                                                        <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource SettingsCount}">
                                                                        <Binding Path="ItemCount"/>
                                                                        <Binding Path="Language" Source="{x:Static loc:Loc.Instance}"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <ItemsPresenter/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingViewModel}">
                            <Border Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <Border x:Name="InfoIcon" Width="18" Height="18" CornerRadius="9" Margin="7,0,0,0" VerticalAlignment="Center"
                                                    Background="#1FFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" Cursor="Hand"
                                                    MouseLeftButtonUp="InfoIcon_Click"
                                                    ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="120000" ToolTipService.Placement="Bottom">
                                                <Border.ToolTip>
                                                    <ToolTip MaxWidth="520" Padding="0" Background="Transparent" BorderThickness="0" HasDropShadow="False">
                                                        <Border CornerRadius="14" Padding="16,12" Background="#F21A1530" BorderBrush="#55FFFFFF" BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                <TextBlock Text="{Binding InfoText}" FontSize="12" Foreground="#E6FFFFFF" TextWrapping="Wrap" LineHeight="18"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <TextBlock Text="i" FontSize="11" FontWeight="Bold" FontStyle="Italic" FontFamily="Georgia"
                                                           Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                            </Border>
                                            <Border CornerRadius="8" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    BorderThickness="1" BorderBrush="{Binding Recommendation, Converter={StaticResource RecBrush}}">
                                                <TextBlock Text="{Binding RecommendationText}" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{Binding Recommendation, Converter={StaticResource RecBrush}}"/>
                                            </Border>
                                            <Border CornerRadius="8" Padding="7,1" Margin="6,0,0,0" Background="#1AFFFFFF" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ScopeText}" FontSize="9.5" Foreground="{StaticResource TextSecondary}"/>
                                            </Border>
                                            <Border CornerRadius="8" Padding="7,1" Margin="6,0,0,0" Background="#2634D399" VerticalAlignment="Center"
                                                    ToolTip="{Binding NativeTooltip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNative}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding NativeBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Width="30"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsEditable}" IsChecked="{Binding IsApplied, Mode=TwoWay}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Activity drawer (collapsible) -->
            <Border Grid.Row="4" Margin="28,0,28,18" CornerRadius="20" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Effect="{StaticResource Elevation}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,6,8,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Padding="10,4" FontSize="11" Command="{Binding OpenBackupFolderCommand}" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr BackupsFolder}"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Padding="10,4" FontSize="11" Command="{Binding ClearLogCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Clear}"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="DrawerToggle" Style="{StaticResource DrawerToggle}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=DrawerToggle}" Value="True">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{loc:Tr Activity}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Border CornerRadius="8" Background="{StaticResource AccentSoft}" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Log.Count}" FontSize="10.5" Foreground="#C9B8FF"/>
                                </Border>
                                <ProgressBar IsIndeterminate="True" Width="90" Height="3" Margin="12,0,8,0" VerticalAlignment="Center"
                                             Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="#C9B8FF" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </StackPanel>
                        </ToggleButton>
                    </DockPanel>
                    <Border Height="150" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsChecked, ElementName=DrawerToggle, Converter={StaticResource BoolToVis}}">
                        <ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" Margin="8,6,8,8"
                                 Foreground="#B7B1D3" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" ItemContainerStyle="{StaticResource LogItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
